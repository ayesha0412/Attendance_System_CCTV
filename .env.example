# =====================================================================
# Face Detection CCTV — Environment Template
# Copy this file to `.env` and fill in your values.
# =====================================================================

# ---- Hikvision Camera ----
CAMERA_USERNAME=your_camera_user
CAMERA_PASSWORD=your_camera_password
CAMERA_IP=192.168.1.64
CAMERA_PORT=554

# Hikvision RTSP channel:
#   101 = Channel 1 main stream (1080p/4K)
#   102 = Channel 1 sub stream  (720p — recommended for detection)
CAMERA_CHANNEL=101

# ---- AMS Push (outgoing) ----
# Where to POST attendance events. Leave blank to disable.
# Body: { "employee_id": "061", "timestamp": "2026-06-11T09:15:32" }
ATTENDANCE_API_URL=
ATTENDANCE_API_KEY=

# ---- API Auth (incoming) ----
# Bearer token required to read /api/v1/attendance/* endpoints.
# Leave blank for open access (dev only).
# Generate: openssl rand -hex 16
ATTENDANCE_READ_KEY=
